// AROHA — core data model.
//
// Design rules (see AROHA_Master_Product_Specification §6, §52):
// - The backend owns authoritative game state. AI output is never written
//   directly into progression tables.
// - Progression is auditable: XP and stat gains are append-only transactions.
//   Level, totals and character tier are derived, never stored as bare numbers.
// - Single user for now, but every user-owned row carries `userId` so real
//   accounts can be introduced without reshaping the schema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

/// Areas of life that goals and quests belong to (spec §22).
enum LifeArea {
  PHYSICAL
  MENTAL
  LEARNING
  SOCIAL
  PERSONAL_GOAL
  CREATIVITY
  EXPERIENCES
  CAREER
  FINANCE
  SKILLS
  RELATIONSHIPS
  PERSONAL_DEVELOPMENT
}

/// Character attributes (spec §14).
enum Attribute {
  INTELLECT
  STRENGTH
  SOCIAL
  CREATIVITY
  DISCIPLINE
  SKILLS
}

/// Lifecycle status. Archiving is separate (Goal.archivedAt) so a goal keeps
/// its last status when put away.
enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

/// How familiar the user already is with a goal's subject. Roadmaps skip or
/// compress foundations for experienced users (spec §9).
enum StartingPoint {
  NEW
  SOME_EXPERIENCE
  EXPERIENCED
}

/// Who authored a piece of roadmap content.
enum ContentSource {
  USER
  TEMPLATE
  AI
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

/// Quest lifecycle. DEFERRED quests are offered again the next day; quests
/// left unfinished when their day ends become EXPIRED (never punished).
enum QuestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  DEFERRED
  EXPIRED
}

/// The user's energy check-in for a day (spec §55: recovery and flexibility).
enum DayEnergy {
  LOW
  NORMAL
  HIGH
}

enum QuestDifficulty {
  EASY
  MEDIUM
  HARD
}

/// Who proposed a quest. AI-sourced quests are still validated by the backend.
enum QuestSource {
  AI
  SYSTEM
  USER
}

/// What produced an XP transaction. Paired with `sourceId` for idempotency.
enum XpSourceType {
  QUEST_COMPLETION
  MISSION_COMPLETION
  MILESTONE_COMPLETION
  GOAL_COMPLETION
  CHALLENGE_COMPLETION
  PROJECT_COMPLETION
  ASSESSMENT_PASSED
  EXPERIMENT_COMPLETION
  ACHIEVEMENT
  ADJUSTMENT
}

/// Challenge lifecycle. ENDED means the window closed short of the target —
/// recorded without judgement; the days done still counted (spec §11, §18).
enum ChallengeStatus {
  ACTIVE
  COMPLETED
  ENDED
  ABANDONED
}

enum ReflectionKind {
  QUEST
  DAILY
  WEEKLY
}

/// Visual base shape of the character avatar.
enum AvatarStyle {
  ORB
  CREST
  MONOGRAM
}

enum TimeOfDay {
  EARLY_MORNING
  MORNING
  AFTERNOON
  EVENING
  FLEXIBLE
}

/// How stretching the user wants their days to feel (spec §24).
enum ChallengeLevel {
  GENTLE
  BALANCED
  AMBITIOUS
}

/// Ways the user can realistically move their body (spec §3 PHYSICAL).
enum MovementOption {
  GYM
  HOME_WORKOUT
  WALKING
  RUNNING
  CYCLING
  SPORTS
  YOGA_MOBILITY
  OUTDOORS
}

/// How the user prefers to learn (spec §3 LEARNING).
enum LearningFormat {
  READING
  VIDEO
  AUDIO
  HANDS_ON
  COURSES
  AI_LESSONS
}

/// Project lifecycle (spec §19). Completing requires evidence.
enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  PAUSED
  COMPLETED
}

/// What kind of thing a project makes. Meta (life area, suggested skill
/// trees) lives in src/modules/projects/categories.ts.
enum ProjectCategory {
  SOFTWARE
  WRITING
  PHOTOGRAPHY
  MUSIC
  ART
  PRODUCT
  COOKING
  FITNESS
  LANGUAGE
  COMMUNITY
  OTHER
}

/// The shape of a piece of proof (spec §20).
enum EvidenceKind {
  LINK
  REPOSITORY
  DOCUMENT
  MEDIA
  NOTE
}

/// Assessment formats (spec §25).
enum AssessmentKind {
  QUIZ
  PRACTICAL
  PROJECT
}

/// Non-punitive outcomes: an attempt either passed or is "not yet".
enum AssessmentOutcome {
  PASSED
  NOT_YET
}

/// Who judged an attempt — shown next to every result, so proof is honest
/// about where it came from.
enum AssessmentEvaluator {
  /// Deterministic grading against the definition's answer key.
  AUTO_GRADED
  /// AI rubric scores; pass/fail still decided by backend rules.
  AI
  /// The user's own rubric ratings, accepted only with evidence attached.
  SELF_REVIEW
}

/// How a day felt, from the end-of-day reflection (spec §42, §45).
enum DayMood {
  ROUGH
  OKAY
  GOOD
  GREAT
}

/// Experiment lifecycle (spec §41). REVIEW_DUE: the window closed (or the user
/// wrapped up early) and the end-of-experiment questions are waiting.
enum ExperimentStatus {
  ACTIVE
  REVIEW_DUE
  REVIEWED
  ABANDONED
}

/// "Did you improve?" — honest, non-numeric answers.
enum ExperimentImprovement {
  NOT_REALLY
  A_LITTLE
  NOTICEABLY
  A_LOT
}

/// "Do you want to continue?"
enum ExperimentDecision {
  MAKE_IT_A_GOAL
  KEEP_EXPLORING
  NOT_FOR_NOW
}

// ─── Identity ───────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  /// Stable handle. The single local user is resolved by handle.
  handle         String    @unique
  displayName    String
  pronouns       String?
  bio            String?
  /// IANA timezone, e.g. "Asia/Kolkata". Defines the user's calendar day.
  timezone       String    @default("UTC")
  /// First time the user saved their own profile details.
  profileSavedAt DateTime?
  onboardedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  character        Character?
  preferences      UserPreferences?
  interests        UserInterest[]
  lifeAreas        UserLifeArea[]
  goals            Goal[]
  dailyQuestSets   DailyQuestSet[]
  quests           Quest[]
  questCompletions QuestCompletion[]
  xpTransactions   XpTransaction[]
  statTransactions StatTransaction[]
  skills           UserSkill[]
  skillXp          SkillXpTransaction[]
  achievements     UserAchievement[]
  challenges       Challenge[]
  projects         Project[]
  evidence         Evidence[]
  assessments      AssessmentAttempt[]
  reflections      Reflection[]
  journalEntries   JournalEntry[]
  experiments      Experiment[]
}

/// The user's living AROHA character (spec §7, §30). Holds game-facing
/// identity only; level, XP and stats are derived from the ledgers.
model Character {
  id           String      @id @default(cuid())
  userId       String      @unique
  /// Short personal motto shown on the character card.
  motto        String?
  avatarStyle  AvatarStyle @default(ORB)
  /// Palette key, validated in app code (src/modules/identity/avatar.ts).
  avatarColor  String      @default("violet")
  /// Emblem key, validated in app code (src/modules/identity/avatar.ts).
  avatarEmblem String      @default("sprout")
  /// First time the user saved their own appearance.
  customizedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Basic personal preferences that later shape quest generation.
/// No row means the user hasn't set preferences; defaults apply.
model UserPreferences {
  id                 String           @id @default(cuid())
  userId             String           @unique
  /// Realistic time available for growth activities on a normal day.
  dailyMinutes       Int              @default(60)
  preferredTimeOfDay TimeOfDay        @default(FLEXIBLE)
  challengeLevel     ChallengeLevel   @default(BALANCED)
  movementOptions    MovementOption[]
  learningFormats    LearningFormat[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserInterest {
  id        String    @id @default(cuid())
  userId    String
  label     String
  /// Normalised label, used to prevent duplicates.
  slug      String
  /// Set when the interest came from a life-area suggestion.
  lifeArea  LifeArea?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
}

/// The user's relationship with a life area (spec §22–23).
/// Core daily areas are always active even without a row.
model UserLifeArea {
  id        String   @id @default(cuid())
  userId    String
  lifeArea  LifeArea
  isActive  Boolean  @default(true)
  /// Current area of focus. At most three, enforced in the identity service.
  isFocus   Boolean  @default(false)
  /// 1-based order among focus areas; null when not a focus.
  focusRank Int?
  /// What the user wants from this area, in their own words.
  intention String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lifeArea])
}

// ─── Goals → Milestones → Missions (spec §8–10) ─────────────────────────────

model Goal {
  id            String        @id @default(cuid())
  userId        String
  title         String
  description   String?
  lifeArea      LifeArea
  /// Why the goal matters, in the user's own words.
  motivation    String?
  /// What "done" looks like, e.g. "Run a 10k under an hour".
  target        String?
  /// Calendar date only.
  deadline      DateTime?     @db.Date
  startingPoint StartingPoint @default(NEW)
  status        GoalStatus    @default(ACTIVE)
  /// Lower number = higher priority. The lowest is the "major goal".
  priority      Int           @default(0)
  completedAt   DateTime?
  pausedAt      DateTime?
  /// Set when archived; archived goals are hidden and read-only.
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones       Milestone[]
  missions         Mission[]
  roadmapRevisions RoadmapRevision[]
  quests           Quest[]
  experiments      Experiment[]

  @@index([userId, status])
  @@index([userId, archivedAt])
}

/// A stage of the roadmap. Status is derived from its missions when it has
/// any (see src/modules/goals/progress.ts) and stored for cheap querying.
model Milestone {
  id          String          @id @default(cuid())
  goalId      String
  title       String
  description String?
  /// 0-based position within the goal. Not unique so reordering is simple.
  order       Int
  status      MilestoneStatus @default(PENDING)
  source      ContentSource   @default(USER)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  goal     Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  missions Mission[]

  @@index([goalId, order])
}

/// A concrete objective inside a milestone (spec §10). The bridge from
/// long-term goals to daily quests.
model Mission {
  id          String          @id @default(cuid())
  /// Denormalised from the milestone for goal-level queries.
  goalId      String
  milestoneId String
  title       String
  description String?
  /// 0-based position within the milestone.
  order       Int
  /// PENDING, COMPLETED or SKIPPED (IN_PROGRESS is milestone-only).
  status      MilestoneStatus @default(PENDING)
  source      ContentSource   @default(USER)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  goal      Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  quests    Quest[]

  @@index([goalId])
  @@index([milestoneId, order])
}

/// Snapshot of a generated or applied roadmap. Every generation (template
/// today, AI Mentor later) is recorded so changes stay auditable.
model RoadmapRevision {
  id        String        @id @default(cuid())
  goalId    String
  source    ContentSource
  /// Generator identifier, e.g. "rule-based@1:programming" or an AI model id.
  generator String
  summary   String?
  /// The validated RoadmapDraft that was applied (src/modules/goals/roadmap.ts).
  snapshot  Json
  createdAt DateTime      @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
}

// ─── Quests (spec §3–4, §53) ────────────────────────────────────────────────

/// One per user per calendar day (in the user's timezone). Created once on
/// the first visit of the day; refreshing never regenerates it.
model DailyQuestSet {
  id        String    @id @default(cuid())
  userId    String
  /// Calendar date only; time component is always 00:00.
  date      DateTime  @db.Date
  energy    DayEnergy @default(NORMAL)
  /// Why this set was composed the way it was (shown to the user).
  rationale String?
  /// Generator identifier, e.g. "rule-based@1" or an AI model id.
  generator String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  quests Quest[]

  @@unique([userId, date])
}

model Quest {
  id               String          @id @default(cuid())
  userId           String
  dailyQuestSetId  String?
  goalId           String?
  missionId        String?
  lifeArea         LifeArea
  /// Position in the day: a core category ("PHYSICAL", …) or "BONUS".
  /// Unique within a set, so a day can never hold two quests for one slot.
  slot             String
  isCore           Boolean         @default(true)
  sortOrder        Int             @default(0)
  /// Template (or AI plan) the quest came from; used to avoid repeats.
  templateKey      String
  title            String
  description      String?
  /// Short practical guide shown on the quest page.
  steps            String[]
  /// Category-specific content, e.g. a learning experience. Shape validated
  /// in src/modules/quests/payload.ts.
  payload          Json?
  difficulty       QuestDifficulty @default(MEDIUM)
  estimatedMinutes Int?
  /// Set by the backend progression rules, never trusted from AI output.
  xpReward         Int
  status           QuestStatus     @default(PENDING)
  source           QuestSource
  /// Why the quest was chosen for this user.
  rationale        String?
  startedAt        DateTime?
  skippedAt        DateTime?
  /// "What got in the way?" — the user's answer when skipping.
  skipReason       String?
  /// Times the user swapped this slot for a different quest today.
  swapCount        Int             @default(0)
  /// The deferred quest this one continues, if carried over from a past day.
  carriedFromId    String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyQuestSet DailyQuestSet?   @relation(fields: [dailyQuestSetId], references: [id], onDelete: SetNull)
  goal          Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  mission       Mission?         @relation(fields: [missionId], references: [id], onDelete: SetNull)
  carriedFrom   Quest?           @relation("QuestCarryOver", fields: [carriedFromId], references: [id], onDelete: SetNull)
  carriedTo     Quest?           @relation("QuestCarryOver")
  completion    QuestCompletion?

  @@unique([dailyQuestSetId, slot])
  @@index([userId, status])
  @@index([userId, templateKey])
}

model QuestCompletion {
  id          String   @id @default(cuid())
  questId     String   @unique
  userId      String
  completedAt DateTime @default(now())
  /// Optional short reflection captured at completion.
  note        String?
  /// Optional measurable result (e.g. "32 minutes", "15 pages").
  result      String?
  /// Optional structured evidence (links, numbers). Shape validated in app code.
  evidence    Json?
  /// XP the quest was worth when completed. Recorded, not yet awarded: the
  /// progression engine turns completions into XpTransactions.
  xpReward    Int
  updatedAt   DateTime @updatedAt

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

// ─── Progression ledger (spec §12–14) ───────────────────────────────────────

/// Append-only XP ledger. Total XP and level are derived from these rows.
model XpTransaction {
  id         String       @id @default(cuid())
  userId     String
  amount     Int
  sourceType XpSourceType
  /// Id of the quest/mission/goal/achievement that produced the XP.
  /// Unique per source so the same action can never award XP twice.
  sourceId   String?
  lifeArea   LifeArea?
  reason     String
  createdAt  DateTime     @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  statTransactions StatTransaction[]

  @@unique([sourceType, sourceId])
  @@index([userId, createdAt])
}

/// Attribute gains, each tied to the XP event that caused it.
model StatTransaction {
  id              String    @id @default(cuid())
  userId          String
  xpTransactionId String
  attribute       Attribute
  amount          Int
  createdAt       DateTime  @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  xpTransaction XpTransaction @relation(fields: [xpTransactionId], references: [id], onDelete: Cascade)

  @@unique([xpTransactionId, attribute])
  @@index([userId, attribute])
}

// ─── Skills (spec §15–16) ───────────────────────────────────────────────────

/// One domain of capability — Programming, Fitness, Music… (spec §15).
/// Trees are rows, not code, so AI-generated skill paths can add trees later.
model SkillTree {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  emoji       String        @default("✨")
  lifeArea    LifeArea
  source      ContentSource @default(TEMPLATE)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  skills Skill[]
}

/// Skill catalogue. `parentId` forms the branch structure inside a tree;
/// `requiresId` + `unlockLevel` gate when a skill opens up (spec §16).
/// Skills are deliberately unequal: each carries its own XP cost and depth.
model Skill {
  id          String        @id @default(cuid())
  treeId      String
  slug        String        @unique
  name        String
  description String?
  lifeArea    LifeArea
  parentId    String?
  /// 0-based position among siblings, for stable tree rendering.
  order       Int           @default(0)
  /// Highest level this skill reaches. Deep skills go further than basics.
  maxLevel    Int           @default(5)
  /// XP cost of the first level; later levels cost more (modules/skills/levels.ts).
  baseXp      Int           @default(50)
  /// The skill that must be levelled before this one opens; null = open from the start.
  requiresId  String?
  /// Level `requires` must reach before this skill unlocks.
  unlockLevel Int           @default(1)
  source      ContentSource @default(TEMPLATE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tree           SkillTree            @relation(fields: [treeId], references: [id], onDelete: Cascade)
  parent         Skill?               @relation("SkillHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Skill[]              @relation("SkillHierarchy")
  requires       Skill?               @relation("SkillUnlock", fields: [requiresId], references: [id], onDelete: SetNull)
  unlocks        Skill[]              @relation("SkillUnlock")
  userSkills     UserSkill[]
  xpTransactions SkillXpTransaction[]
  projects       ProjectSkill[]
  assessments    AssessmentAttempt[]

  @@index([treeId, order])
}

/// The user's relationship with a skill: created the first time real progress
/// lands in it. XP and level are derived from the SkillXpTransaction ledger.
model UserSkill {
  id         String   @id @default(cuid())
  userId     String
  skillId    String
  unlockedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

/// Append-only per-skill XP ledger — the skill progression history (spec §15).
/// Unique per (skill, source) so one action can feed several skills but never
/// pays the same skill twice.
model SkillXpTransaction {
  id         String       @id @default(cuid())
  userId     String
  skillId    String
  amount     Int
  sourceType XpSourceType
  /// Id of the quest/mission/assessment that produced the progress.
  sourceId   String?
  reason     String
  createdAt  DateTime     @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, sourceType, sourceId])
  @@index([userId, createdAt])
  @@index([userId, skillId])
}

// ─── Projects, evidence & assessments (spec §19–21, §25) ────────────────────

/// A real thing the user is making. Projects are where claims become proof.
model Project {
  id          String          @id @default(cuid())
  userId      String
  title       String
  description String?
  category    ProjectCategory
  status      ProjectStatus   @default(PLANNING)
  /// What building it taught — shown on the Skill Passport.
  reflection  String?
  startedAt   DateTime?
  completedAt DateTime?
  /// XP the completion paid, priced by the backend when completed.
  xpAwarded   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills      ProjectSkill[]
  milestones  ProjectMilestone[]
  evidence    Evidence[]
  assessments AssessmentAttempt[]

  @@index([userId, status])
}

model ProjectSkill {
  id        String @id @default(cuid())
  projectId String
  skillId   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([projectId, skillId])
  @@index([skillId])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  /// 0-based position within the project.
  order       Int
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

/// One piece of proof (spec §20): a link, repository, document, media or a
/// written note. Belongs to a project or an assessment attempt; the skills it
/// proves follow from its owner.
model Evidence {
  id        String       @id @default(cuid())
  userId    String
  projectId String?
  attemptId String?
  kind      EvidenceKind
  title     String
  url       String?
  note      String?
  createdAt DateTime     @default(now())

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attempt AssessmentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId])
}

/// One submitted, evaluated assessment. The definition is snapshotted, so
/// catalogue changes (or AI-generated assessments later) never rewrite
/// history. Evaluation happens on submit; pass/fail is always decided by
/// backend rules, whoever produced the scores.
model AssessmentAttempt {
  id            String              @id @default(cuid())
  userId        String
  /// Catalogue key (src/modules/assessments/catalogue.ts) or "project.<skill>".
  assessmentKey String
  kind          AssessmentKind
  skillId       String
  title         String
  /// The definition as it was when taken.
  definition    Json
  /// Quiz answers (option indices) or rubric self-ratings, by key.
  answers       Json?
  /// Written response: what was done and how.
  response      String?
  projectId     String?
  score         Int
  maxScore      Int
  percent       Int
  outcome       AssessmentOutcome
  evaluator     AssessmentEvaluator
  /// Per-question or per-criterion notes plus a summary and next step.
  feedback      Json
  /// XP paid by this attempt (only a first pass pays).
  xpAwarded     Int                 @default(0)
  createdAt     DateTime            @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill    Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  project  Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  evidence Evidence[]

  @@index([userId, createdAt])
  @@index([userId, skillId])
  @@index([userId, assessmentKey])
}

// ─── Achievements & streaks (spec §17–18) ───────────────────────────────────

/// Achievement catalogue. Unlock rules live in the progression engine, keyed by slug.
model Achievement {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  xpReward    Int      @default(0)
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// Streaks are derived from the quest-completion ledger, never stored
// (src/modules/streaks). Missing a day can therefore never delete anything.

// ─── Challenges (spec §11) ──────────────────────────────────────────────────

/// A temporary commitment started from a template, e.g. "7-Day Reading".
/// Progress days are earned by completing matching quests — challenges never
/// have their own checkbox, so they always reflect real action.
model Challenge {
  id           String          @id @default(cuid())
  userId       String
  /// Template the challenge came from (src/modules/challenges/catalogue.ts).
  templateKey  String
  title        String
  description  String?
  emoji        String          @default("🔥")
  lifeArea     LifeArea
  /// Length of the window, in calendar days.
  durationDays Int
  /// Days of real action needed to complete — less than the window, so a
  /// missed day never sinks the whole attempt (spec §18).
  targetDays   Int
  /// Completion bonus, priced by the backend when the challenge starts.
  xpReward     Int
  /// First day of the window (calendar date in the user's timezone).
  startDate    DateTime        @db.Date
  status       ChallengeStatus @default(ACTIVE)
  completedAt  DateTime?
  /// When the window closed or the user set it down.
  endedAt      DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  days ChallengeDay[]

  @@index([userId, status])
}

/// One earned day of a challenge, credited by a completed quest. Unique per
/// (challenge, date): two matching quests in a day still earn one day.
model ChallengeDay {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  /// Calendar date (user's timezone) the credit belongs to.
  date        DateTime @db.Date
  /// The quest whose completion earned the day; used to undo credit exactly.
  questId     String?
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, date])
  @@index([userId, questId])
}

// ─── Reflection & journal (spec §42, §45) ──────────────────────────────────

/// A structured reflection. DAILY reflections are the end-of-day questions,
/// one per user per calendar day. The user's words and the AI's summary are
/// stored separately, and the summary records where it came from.
model Reflection {
  id            String         @id @default(cuid())
  userId        String
  kind          ReflectionKind
  /// Calendar date the reflection is about (user's timezone).
  date          DateTime       @db.Date
  mood          DayMood?
  learned       String?
  wentWell      String?
  difficult     String?
  proud         String?
  differently   String?
  /// Legacy free-text "what should tomorrow look like?".
  tomorrow      String?
  aiSummary     String?
  /// One gentle, concrete idea for tomorrow, from the summary.
  aiSuggestion  String?
  /// "ai" or "fallback" — shown next to the summary.
  summarySource String?
  summarizedAt  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, date])
  @@index([userId, date])
}

/// A private journal entry. Visible only to its owner: never shown on the
/// passport or timeline, and never sent to AI.
model JournalEntry {
  id        String    @id @default(cuid())
  userId    String
  /// Calendar date the entry belongs to (user's timezone).
  date      DateTime  @db.Date
  title     String?
  body      String
  mood      DayMood?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ─── Experiments (spec §41) ─────────────────────────────────────────────────

/// Trying something for a while without committing to it. An active
/// experiment adds a short daily quest; completing it earns a practice day.
model Experiment {
  id           String                 @id @default(cuid())
  userId       String
  /// Template key (src/modules/experiments/catalogue.ts) or "custom".
  templateKey  String
  title        String
  /// What's being tried, e.g. "photography". Used in quests and matching.
  topic        String
  description  String?
  emoji        String                 @default("🧪")
  lifeArea     LifeArea
  /// Skill tree the practice feeds, when one fits.
  skillTree    String?
  durationDays Int
  /// Minutes of practice suggested per day.
  dailyMinutes Int                    @default(20)
  startDate    DateTime               @db.Date
  status       ExperimentStatus       @default(ACTIVE)
  endedAt      DateTime?
  // End-of-experiment review (spec §41)
  enjoyment    Int?
  interest     Int?
  improvement  ExperimentImprovement?
  decision     ExperimentDecision?
  learned      String?
  reviewedAt   DateTime?
  xpAwarded    Int                    @default(0)
  /// The goal created when the user chose to make it a goal.
  goalId       String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  days ExperimentDay[]

  @@index([userId, status])
}

/// One practice day, earned by completing that day's experiment quest.
model ExperimentDay {
  id           String   @id @default(cuid())
  experimentId String
  userId       String
  date         DateTime @db.Date
  questId      String?
  createdAt    DateTime @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, date])
  @@index([userId, questId])
}
