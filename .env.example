# Copy to .env and fill in values.

# PostgreSQL connection string used by Prisma (CLI + runtime).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aroha?schema=public"

# AI service layer. "mock" (default) runs fully offline with deterministic
# fallbacks. "anthropic" turns on the real AI Mentor.
AI_PROVIDER="mock"

# Required only when AI_PROVIDER="anthropic". Without it, AROHA logs a warning
# and uses its deterministic fallbacks — the app still works.
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional. The Claude model the AI Mentor uses.
# AI_MODEL="claude-opus-5"
