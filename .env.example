# Copy to .env and fill in values.

# PostgreSQL connection string used by Prisma (CLI + runtime).
# Local:    postgresql://USER:PASSWORD@localhost:5432/aroha?schema=public
# Supabase: the *Session pooler* string, plus ?sslmode=require (see DEPLOYMENT.md)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aroha?schema=public"

# Optional. Supabase's CA certificate, to verify the database's TLS
# certificate as well as encrypt (one line; write newlines as \n).
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Sign-in with Supabase Auth. Leave both unset for local development: the app
# then runs as one local user with no sign-in. Production refuses to start
# without them unless AUTH_MODE="local" is set on purpose.
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only Supabase secret key (sb_secret_…). Needed for account deletion
# to remove the person's sign-in; without it, deletion is refused rather than
# half-done. NEVER prefix with NEXT_PUBLIC_ and never commit it.
# SUPABASE_SECRET_KEY="sb_secret_..."

# Optional. Server errors are always logged; set this to also post each one
# to a Discord or Slack channel (an incoming-webhook URL).
# ERROR_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Optional. "supabase" or "local". Defaults to "supabase" when the keys above
# are set. "local" in production means one shared user and no sign-in — only
# for a private deployment behind its own password.
# AUTH_MODE="local"

# AI service layer. "mock" (default) runs fully offline with deterministic
# fallbacks. The AI Mentor page is "coming soon" either way.
AI_PROVIDER="mock"

# Required only when AI_PROVIDER="anthropic".
# ANTHROPIC_API_KEY="sk-ant-..."
# AI_MODEL="claude-opus-5"
